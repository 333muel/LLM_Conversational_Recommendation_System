# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=recommendation_db

# RecBole Configuration
# Relative to the backend folder (../ to go to root of unified-ai-agent-system)
RECBOLE_DATASET_PATH=../data/amazon_sentiment_200k
RECBOLE_MODEL_CHECKPOINT=../checkpoints/LightGCN-Nov-09-2025_21-24-15.pth
RECBOLE_MODEL_NAME=LightGCN

# LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:latest

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# Recommendation Configuration
RECOMMENDATION_TOP_K=10
RECOMMENDATION_CONTEXT_K=20
